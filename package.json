{
  "name": "pi-codex-compact",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Pi extension: Codex-style server-side compaction for OpenAI Responses models.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrzzmrzz/pi-codex-compact.git"
  },
  "homepage": "https://github.com/mrzzmrzz/pi-codex-compact#readme",
  "bugs": {
    "url": "https://github.com/mrzzmrzz/pi-codex-compact/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "openai",
    "responses",
    "compaction",
    "codex"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "tests",
    "README.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-agent-core": { "optional": true }
  },
  "scripts": {
    "smoke": "node --experimental-strip-types ./scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run smoke",
    "test:live": "node --experimental-strip-types ./tests/live/openai-compaction-rpc-live.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
